            "byte_end": 4454,
            "span_sha256": "2795ca1f3ba4abebebdaabff71a8a8667be9e3efdfd4077527e388e535a5c541",
            "evidence_ref": "source-extraction://sha256/fc021b378084a7b07b71b70fbd0020cfd5c30df546cbedd27071eaad94800ef5/fc021b378084a7b07b71b70fbd0020cfd5c30df546cbedd27071eaad94800ef5/span/evidence-beat-06-line-1/2795ca1f3ba4abebebdaabff71a8a8667be9e3efdfd4077527e388e535a5c541"
          },
          {
            "span_id": "evidence-beat-06-line-2",
            "exact_text": "잠깐 생각해 봐요. 각각 팔만 삼천, 팔만 사천이에요.",
