    "planned_segments": [
      {
        "scene_id": "scene-01",
        "exact_text": "두 경기장 모두 관중이 약 팔만 삼천 명이래요."
      },
      {
        "scene_id": "scene-01",
        "exact_text": "그런데 정말 똑같이 왔을까요?"
      },
      {
        "scene_id": "scene-02",
        "exact_text": "천의 자리까지 반올림할 땐 백의 자리 숫자를 봐요."
      },
      {
        "scene_id": "scene-02",
        "exact_text": "영부터 사까지는 버리고, 오부터 구까지는 올려요."
      },
      {
        "scene_id": "scene-02",
        "exact_text": "가 경기장은 팔만 이천팔백 명. 백의 자리 숫자가"
      },
      {
        "scene_id": "scene-02",
        "exact_text": "팔이니까 올려요."
      },
      {
        "scene_id": "scene-03",
        "exact_text": "가 경기장은 팔만 삼천 명이 돼요. 나 경기장의"
      },
      {
        "scene_id": "scene-03",
        "exact_text": "팔만 삼천이백 명도 팔만 삼천 명이 돼요."
      },
      {
        "scene_id": "scene-04",
        "exact_text": "하지만 실제로 나 경기장이 사백 명 더 많아요."
      },
      {
        "scene_id": "scene-04",
        "exact_text": "반올림한 수가 같다고 실제 수가 같은 건 아니에요."
      },
      {
        "scene_id": "scene-05",
        "exact_text": "수직선에서 팔만 이천오백부터 팔만"
      },
      {
        "scene_id": "scene-05",
        "exact_text": "삼천사백구십구까지 모두 팔만 삼천이 돼요."
      },
      {
        "scene_id": "scene-05",
        "exact_text": "그러니까 팔만 삼천이라는 이름 아래에 실제 수가 천"
      },
      {
        "scene_id": "scene-05",
        "exact_text": "개나 모여 있는 셈이에요."
      },
      {
        "scene_id": "scene-06",
        "exact_text": "그럼 팔만 삼천사백구십구는? 팔만"
      },
      {
        "scene_id": "scene-06",
        "exact_text": "삼천오백은? 잠깐 생각해 봐요. 각각 팔만 삼천,"
      },
      {
        "scene_id": "scene-06",
        "exact_text": "팔만 사천이에요. 반올림한 수가 같아도 실제 수는"
      },
      {
        "scene_id": "scene-06",
        "exact_text": "다를 수 있어요."
      }
    ]
  },
