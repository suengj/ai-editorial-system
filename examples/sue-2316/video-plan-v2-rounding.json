            "span_sha256": "6b4e37b0bb78453f20392ae24c6f80a0efbe1bc54e7e464ab57cff82dc4cac0d",
            "evidence_ref": "source-extraction://sha256/fc021b378084a7b07b71b70fbd0020cfd5c30df546cbedd27071eaad94800ef5/fc021b378084a7b07b71b70fbd0020cfd5c30df546cbedd27071eaad94800ef5/span/evidence-beat-05-line-1/6b4e37b0bb78453f20392ae24c6f80a0efbe1bc54e7e464ab57cff82dc4cac0d"
          },
          {
            "span_id": "evidence-beat-05-line-2",
            "exact_text": "그러니까 팔만 삼천이라는 이름 아래에 실제 수가 천 개나 모여 있는 셈이에요.",
            "source_sha256": "fc021b378084a7b07b71b70fbd0020cfd5c30df546cbedd27071eaad94800ef5",
            "extraction_sha256": "fc021b378084a7b07b71b70fbd0020cfd5c30df546cbedd27071eaad94800ef5",
            "byte_start": 4274,
            "byte_end": 4379,
