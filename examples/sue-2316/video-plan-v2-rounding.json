    "planned_segments": [
      {
        "scene_id": "scene-01",
        "exact_text": "관중 수를 반올림하면 같아도 실제 수는 다를 수"
      },
      {
        "scene_id": "scene-01",
        "exact_text": "있어요."
      },
      {
        "scene_id": "scene-02",
        "exact_text": "천의 자리까지 반올림할 때는 백의 자리 숫자를"
      },
      {
        "scene_id": "scene-02",
        "exact_text": "봐요."
      },
      {
        "scene_id": "scene-03",
        "exact_text": "팔만 이천팔백 명과 팔만 삼천이백 명은 모두 팔만"
      },
      {
        "scene_id": "scene-03",
        "exact_text": "삼천 명이 돼요."
      },
      {
        "scene_id": "scene-04",
        "exact_text": "실제 관중 수의 차이는 사백 명이에요."
      },
      {
        "scene_id": "scene-05",
        "exact_text": "팔만 이천오백부터 팔만 삼천사백구십구까지는 팔만"
      },
      {
        "scene_id": "scene-05",
        "exact_text": "삼천으로 반올림해요."
      },
      {
        "scene_id": "scene-06",
        "exact_text": "팔만 삼천사백구십구는 팔만 삼천, 팔만 삼천오백은"
      },
      {
        "scene_id": "scene-06",
        "exact_text": "팔만 사천이 돼요."
      }
    ]
  },
