            "evidence_ref": "source-extraction://sha256/fc021b378084a7b07b71b70fbd0020cfd5c30df546cbedd27071eaad94800ef5/fc021b378084a7b07b71b70fbd0020cfd5c30df546cbedd27071eaad94800ef5/span/evidence-beat-04-line-1/c29aa881e7e482ffea65df2cf0f58c18b8f5f768db4375147cc0980654ad4d80"
          },
          {
            "span_id": "evidence-beat-04-line-2",
            "exact_text": "반올림한 수가 같다고 실제 수가 같은 건 아니에요.",
            "source_sha256": "fc021b378084a7b07b71b70fbd0020cfd5c30df546cbedd27071eaad94800ef5",
