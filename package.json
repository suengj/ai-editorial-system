{
  "name": "ai-editorial-system",
  "version": "0.1.0",
  "private": false,
  "description": "Editorial Control Plane for suengj.com \u2014 editorial rules, Skills, schemas, and evaluations.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate:boundary": "node scripts/validate-repo-boundary.mjs",
    "validate:source": "node scripts/validate-source-manifest.mjs",
    "validate:article": "node scripts/validate-article-contract.mjs",
    "validate:rights": "node scripts/validate-rights.mjs",
    "validate": "npm run validate:boundary && npm run validate:source && npm run validate:article && npm run validate:rights && npm run validate:skills && npm run validate:plan && npm run validate:presentation",
    "check:gates": "node scripts/check-quality-gates.mjs --bundle schemas/examples/article-artifact.example.json evals/fixtures/golden/G-01-synthesis.md",
    "test:boundary": "node scripts/test-repo-boundary.mjs",
    "test:source": "node scripts/test-source-contract.mjs",
    "test:article": "node scripts/test-article-contract.mjs",
    "test:rights": "node scripts/test-rights-policy.mjs",
    "test:gates": "node scripts/test-quality-gates.mjs",
    "test": "npm run test:boundary && npm run test:source && npm run test:article && npm run test:rights && npm run test:gates && npm run test:profiles && npm run test:skills && npm run test:pipeline && npm run test:eval && npm run test:presentation",
    "check:profile": "node scripts/check-profile.mjs",
    "test:profiles": "node scripts/test-profiles.mjs",
    "validate:skills": "node scripts/validate-skills.mjs",
    "test:skills": "node scripts/test-skill-format.mjs",
    "validate:plan": "node scripts/validate-artifact-plan.mjs",
    "test:pipeline": "node scripts/test-skills-pipeline.mjs",
    "eval": "node scripts/run-eval.mjs",
    "test:eval": "node scripts/test-eval.mjs",
    "validate:presentation": "node scripts/validate-presentation.mjs",
    "test:presentation": "node scripts/test-presentation.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/suengj/ai-editorial-system.git"
  }
}
