{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suengj.com/schemas/visual-production.schema.json",
  "title": "Visual Production Control State",
  "description": "Declared control-plane state only; hashes are supplied lineage values, not observations of a renderer or provider.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "direction_discovery", "telemetry"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "semantic_master": { "$ref": "#/$defs/master" },
    "factual_overlay": { "$ref": "#/$defs/overlay" },
    "publication_composite": { "$ref": "#/$defs/composite" },
    "factual_repair": { "$ref": "#/$defs/repair" },
    "direction_discovery": { "$ref": "#/$defs/discovery" },
    "production_refinement": { "$ref": "#/$defs/refinement" },
    "failure_route": { "$ref": "#/$defs/failure_route" },
    "telemetry": { "$ref": "#/$defs/telemetry" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "runtime": { "description": "Renderer-layer lineage. tool/tool_version identify the rendering pipeline (e.g. a deterministic SVG compiler); provider/model/model_version identify the underlying generative runtime where one is used. Deterministic tools still record provider/model as the tool's own identity so the field is never blank. None of this may appear inside compiled_prompt — see context_isolation.", "type": "object", "additionalProperties": false, "required": ["tool", "provider", "model", "model_version"], "properties": { "tool": { "type": "string", "minLength": 1 }, "tool_version": { "type": "string", "minLength": 1 }, "provider": { "type": "string", "minLength": 1 }, "model": { "type": "string", "minLength": 1 }, "model_version": { "description": "Exact model version or a dated model alias, so quality drift from a silent model swap is diagnosable.", "type": "string", "minLength": 1 }, "quality_tier": { "description": "Reasoning/quality tier, where the provider exposes one. Absent for tools with no such tier.", "type": "string", "minLength": 1 } } },
    "master": { "type": "object", "additionalProperties": false, "required": ["master_id", "asset_ref", "asset_sha256", "render_spec_id", "selected_direction_id", "renderer_lineage"], "properties": { "master_id": { "type": "string", "minLength": 1 }, "asset_ref": { "type": "string", "minLength": 1 }, "asset_sha256": { "$ref": "#/$defs/digest" }, "render_spec_id": { "type": "string", "minLength": 1 }, "selected_direction_id": { "type": "string", "minLength": 1 }, "renderer_lineage": { "$ref": "#/$defs/runtime" } } },
    "overlay": { "type": "object", "additionalProperties": false, "required": ["overlay_id", "asset_ref", "asset_sha256", "payload", "payload_sha256", "declared_factual_invariants", "accessible_text_equivalent"], "properties": { "overlay_id": { "type": "string", "minLength": 1 }, "asset_ref": { "type": "string", "minLength": 1 }, "asset_sha256": { "$ref": "#/$defs/digest" }, "payload": { "type": "object", "additionalProperties": false, "required": ["items"], "properties": { "items": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["item_id", "kind", "exact_text", "source_ref", "accessible_text"], "properties": { "item_id": { "type": "string", "minLength": 1 }, "kind": { "enum": ["number", "short_label", "citation", "axis", "legend", "scale", "chronology", "annotation"] }, "exact_text": { "type": "string", "minLength": 1 }, "source_ref": { "description": "Opaque upstream article-claim reference. This control plane requires a non-empty value. For an article-backed job using article-claim:<article_id>:<claim_id>, the executable validator checks only that <article_id> matches job.article_ref.article_id; <claim_id> remains opaque and is not resolved here.", "type": "string", "minLength": 1 }, "accessible_text": { "type": "string", "minLength": 1 } } } } } }, "payload_sha256": { "$ref": "#/$defs/digest" }, "declared_factual_invariants": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "accessible_text_equivalent": { "type": "string", "minLength": 1 } } },
    "composite": { "type": "object", "additionalProperties": false, "required": ["composite_id", "asset_ref", "asset_sha256", "semantic_master_sha256", "factual_overlay_asset_sha256", "requires_owner_gate"], "properties": { "composite_id": { "type": "string", "minLength": 1 }, "asset_ref": { "type": "string", "minLength": 1 }, "asset_sha256": { "$ref": "#/$defs/digest" }, "semantic_master_sha256": { "$ref": "#/$defs/digest" }, "factual_overlay_asset_sha256": { "$ref": "#/$defs/digest" }, "requires_owner_gate": { "type": "boolean" } } },
    "repair": { "type": "object", "additionalProperties": false, "required": ["kind", "prior_production_ref", "review_ref", "review_sha256", "review_id", "item_decisions"], "properties": { "kind": { "const": "factual_overlay_repair" }, "prior_production_ref": { "type": "string", "minLength": 1 }, "review_ref": { "description": "Repository-contained post-render review whose KEEP/CHANGE/DO_NOT_CHANGE routing authorizes this bounded repair.", "type": "string", "minLength": 1 }, "review_sha256": { "$ref": "#/$defs/digest" }, "review_id": { "type": "string", "pattern": "^visual-review:[a-z0-9-]+$" }, "item_decisions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/repair_item_decision" } } } },
    "repair_item_decision": { "type": "object", "additionalProperties": false, "required": ["item_id", "review_check", "decision", "prior_item_sha256", "current_item_sha256"], "properties": { "item_id": { "type": "string", "minLength": 1 }, "review_check": { "enum": ["textual", "factual", "readability", "mobile"] }, "decision": { "enum": ["KEEP", "CHANGE", "DO_NOT_CHANGE"] }, "prior_item_sha256": { "$ref": "#/$defs/digest" }, "current_item_sha256": { "$ref": "#/$defs/digest" } } },
    "discovery": { "type": "object", "additionalProperties": false, "required": ["phase", "candidates", "selection"], "properties": { "phase": { "const": "direction_discovery" }, "candidates": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["direction_id", "thesis_treatment", "composition_strategy", "article_fit_rationale", "reference_evaluation_ids"], "properties": { "direction_id": { "type": "string", "minLength": 1 }, "thesis_treatment": { "type": "string", "minLength": 1 }, "composition_strategy": { "type": "string", "minLength": 1 }, "article_fit_rationale": { "type": "string", "minLength": 1 }, "reference_evaluation_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } } } } }, "selection": { "type": "object", "additionalProperties": false, "required": ["state"], "properties": { "state": { "enum": ["open", "selected"] }, "selected_direction_id": { "type": "string", "minLength": 1 }, "rationale": { "type": "string", "minLength": 1 } } } } },
    "refinement": { "type": "object", "additionalProperties": false, "required": ["phase", "selected_direction_id", "max_local_edits", "local_edits"], "properties": { "phase": { "const": "production_refinement" }, "selected_direction_id": { "type": "string", "minLength": 1 }, "max_local_edits": { "type": "integer", "minimum": 0 }, "local_edits": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["major_variable", "bounded_delta"], "properties": { "major_variable": { "enum": ["composition", "focal_hierarchy", "subject", "spatial_treatment", "materiality_treatment", "overlay_layout"] }, "bounded_delta": { "type": "string", "minLength": 1 } } } } } },
    "failure_route": { "type": "object", "additionalProperties": false, "required": ["failure_class", "next_action"], "properties": { "failure_class": { "enum": ["wrong_concept", "local_defect", "low_fidelity", "facts_or_text_wrong", "reference_drift", "dashboardization", "human_likes_candidate"] }, "next_action": { "enum": ["new_direction", "local_edit", "fidelity_derivative", "factual_overlay_repair", "recompile_reference_authority", "reroute_composition_renderer", "human_approval_required"] } } },
    "telemetry": { "description": "Self-reported control-plane state; this repository does not observe provider calls or billing.", "type": "object", "additionalProperties": false, "required": ["generation_count", "edit_count", "accepted_asset_outcome"], "properties": { "generation_count": { "description": "Declared, not observed provider telemetry.", "type": "integer", "minimum": 0 }, "edit_count": { "description": "Declared, not observed provider telemetry.", "type": "integer", "minimum": 0 }, "selected_direction_id": { "type": "string", "minLength": 1 }, "accepted_asset_outcome": { "enum": ["not_yet", "accepted", "rejected"] } } }
  }
}
