{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suengj.com/schemas/visual-story-plan.schema.json",
  "title": "Visual story plan (minimal lineage contract)",
  "type": "object",
  "required": [
    "schema_version",
    "beats"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "article_ref"
      ]
    },
    {
      "required": [
        "source_ref"
      ]
    }
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "article_ref": {
      "$ref": "#/$defs/article_ref"
    },
    "source_ref": {
      "$ref": "#/$defs/source_ref"
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "beat_id",
          "function",
          "assertion"
        ],
        "properties": {
          "beat_id": {
            "type": "string",
            "minLength": 1
          },
          "function": {
            "type": "string",
            "minLength": 1
          },
          "assertion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "article_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "article_id",
        "version_number",
        "content_hash",
        "claims_hash"
      ],
      "properties": {
        "article_id": {
          "type": "string",
          "minLength": 1
        },
        "version_number": {
          "type": [
            "integer",
            "string"
          ]
        },
        "content_hash": {
          "type": "string",
          "minLength": 1
        },
        "claims_hash": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "evidence_id",
        "path",
        "sha256",
        "spans"
      ],
      "properties": {
        "kind": {
          "const": "source-evidence"
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "spans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "span_id",
              "byte_start",
              "byte_end",
              "sha256"
            ],
            "properties": {
              "span_id": {
                "type": "string",
                "minLength": 1
              },
              "byte_start": {
                "type": "integer",
                "minimum": 0
              },
              "byte_end": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
