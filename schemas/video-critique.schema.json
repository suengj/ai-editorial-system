{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suengj.com/schemas/video-critique.schema.json",
  "title": "AES Video Self-Critique",
  "description": "Frame-sampled visual critique payload carried beside the shorts_gen critique StageResult.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_ref",
    "render_ref",
    "stage_result",
    "frame_samples"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "render_ref": {
      "type": "string",
      "minLength": 1
    },
    "stage_result": {
      "$ref": "vendor/shorts-gen-6d24e8c/stage-result.schema.json"
    },
    "frame_samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_ref",
          "timestamp_seconds",
          "scene_id",
          "checklist"
        ],
        "properties": {
          "sample_ref": {
            "type": "string",
            "minLength": 1
          },
          "timestamp_seconds": {
            "type": "number",
            "minimum": 0
          },
          "scene_id": {
            "type": "string",
            "pattern": "^scene-[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "checklist": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "criterion",
                "result",
                "evidence_ref"
              ],
              "properties": {
                "criterion": {
                  "enum": [
                    "hook",
                    "readability",
                    "hierarchy",
                    "motion",
                    "information_density",
                    "palette_consistency",
                    "interactive_sequence",
                    "chart_integrity",
                    "audio_contract",
                    "ending"
                  ]
                },
                "result": {
                  "enum": [
                    "pass",
                    "fail"
                  ]
                },
                "evidence_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "finding": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
