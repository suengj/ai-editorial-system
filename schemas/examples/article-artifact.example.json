    "frame": {
      "thesis": "Falling inference prices do not translate into SaaS gross-margin recovery, because the cost that moved is not the cost that binds.",
      "article_worthiness": "The price-drop narrative is widely repeated; the margin consequence is asserted without a cost breakdown.",
      "audience": "Operators and investors who read the pricing headlines and need the margin arithmetic.",
      "source_weighting": "Vendor price sheets are primary for prices and weak for margins; filings are primary for margins. Weight accordingly.",
      "verification_needs": [
        "Current published per-token prices and their effective dates",
        "Reported gross margin for at least one AI-native SaaS filer",
        "Whether the quoted price applies to the tier actually used at scale"
      ],
      "original_value_add": "Decomposes the cost stack to show which line the price drop touches, and what share it represents.",
      "uncertainty": [
        "Negotiated enterprise rates are not public; list prices overstate what large buyers pay.",
        "Serving-infrastructure cost is not separable from other COGS in most filings."
      ],
      "structure": [
        "The claim as usually stated",
        "What the price actually covers",
        "The cost stack, decomposed",
        "What would have to be true for the claim to hold",
        "What remains unknown"
      ]
    },
