{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suengj.com/schemas/render-spec.schema.json",
  "title": "Render Spec",
  "description": "Durable renderer-neutral scene/composition contract for a Visual Brief.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "render_spec_id", "brief_id", "target_geometry", "scene_structure", "focal_hierarchy", "reading_direction", "spatial_treatment", "materiality_treatment", "spatial_layers", "safe_zones", "crop_resilience", "visual_devices", "forbidden_visual_devices", "reference_authority", "text_handling"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "render_spec_id": { "type": "string", "pattern": "^render-spec:[a-z0-9]+(-[a-z0-9]+)*$" },
    "brief_id": { "type": "string", "pattern": "^visual-brief:[a-z0-9]+(-[a-z0-9]+)*$" },
    "target_geometry": { "type": "string", "minLength": 1 },
    "scene_structure": { "type": "string", "minLength": 1 },
    "focal_hierarchy": { "type": "string", "minLength": 1 },
    "information_hierarchy": { "$ref": "#/$defs/information_hierarchy" },
    "reading_direction": { "type": "string", "minLength": 1 },
    "spatial_treatment": { "enum": ["flat_2d", "layered_2d", "shallow_depth", "deep_scene"] },
    "materiality_treatment": { "enum": ["matte_2d", "quiet_linework", "soft_tonal_separation"] },
    "spatial_layers": { "type": "object", "additionalProperties": false, "required": ["generative_semantic", "deterministic_factual"], "properties": { "generative_semantic": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "deterministic_factual": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
    "safe_zones": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "crop_resilience": { "type": "string", "minLength": 1 },
    "crop_anchors": {
      "description": "Semantic anchors that a publication crop may preserve. Review records may select only one of these declared anchors.",
      "type": "array", "minItems": 1,
      "items": { "type": "string", "pattern": "^anchor:[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "publication_display_surfaces": { "$ref": "#/$defs/publication_display_surfaces" },
    "visual_devices": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "forbidden_visual_devices": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "reference_authority": { "type": "object", "additionalProperties": false, "required": ["selected"], "properties": { "selected": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["ref_id", "evaluation_id", "authority", "not_authority", "rationale"], "properties": { "ref_id": { "type": "string", "pattern": "^ref:[a-z0-9]+(-[a-z0-9]+)*$" }, "evaluation_id": { "type": "string", "pattern": "^eval:[a-z0-9]+(-[a-z0-9]+)*$" }, "authority": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "not_authority": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "rationale": { "type": "string", "minLength": 1 } } } } } },
    "text_handling": { "type": "object", "additionalProperties": false, "required": ["article_title"], "properties": { "article_title": { "const": "external_overlay" }, "deterministic_overlay": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "text_ownership": { "$ref": "#/$defs/text_ownership" } } }
  },
  "$defs": {
    "information_hierarchy": {
      "description": "Integrated reader hierarchy that must remain coherent with the selected reference authority.",
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "supporting", "detail"],
      "properties": {
        "primary": { "type": "string", "minLength": 1 },
        "supporting": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "detail": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "text_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_text", "source_ref"],
      "properties": {
        "exact_text": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 }
      }
    },
    "text_ownership": {
      "description": "The three V2.17 ownership classes. Verified generative facts carry a canonical payload, source lineage, and mandatory post-render verification.",
      "type": "object",
      "additionalProperties": false,
      "required": ["article_title", "generative_structural_text", "verified_generative_fact", "deterministic_external_text"],
      "properties": {
        "article_title": { "const": "deterministic_external_text" },
        "generative_structural_text": {
          "type": "object", "additionalProperties": false, "required": ["items"],
          "properties": { "items": { "type": "array", "items": { "type": "string", "minLength": 1 } } }
        },
        "verified_generative_fact": {
          "description": "Null explicitly represents that this ownership class has no items; an object declares generated facts that require authoritative payload lineage and post-render verification.",
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["canonical_payload", "source_lineage", "claim_set", "post_render_verification"],
          "properties": {
            "canonical_payload": {
              "type": "object", "additionalProperties": false,
              "required": ["payload_ref", "payload_sha256", "items"],
              "properties": {
                "payload_ref": { "type": "string", "pattern": "^payload:[a-z0-9]+(-[a-z0-9]+)*$" },
                "payload_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
                "items": { "type": "array", "items": { "$ref": "#/$defs/text_item" } }
              }
            },
            "source_lineage": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "claim_set": { "$ref": "#/$defs/claim_set" },
            "post_render_verification": {
              "type": "object", "additionalProperties": false,
              "required": ["required", "review_dimension", "asset_digest_bound"],
              "properties": { "required": { "const": true }, "review_dimension": { "const": "factual" }, "asset_digest_bound": { "const": true } }
            }
          }
        },
        "deterministic_external_text": {
          "type": "object", "additionalProperties": false,
          "required": ["items", "includes"],
          "properties": {
            "items": { "type": "array", "items": { "$ref": "#/$defs/text_item" } },
            "includes": { "type": "array", "items": { "enum": ["citations", "dense_text", "sensitive_text"] } }
          }
        }
      }
    },
    "publication_display_surfaces": {
      "description": "Authoritative publication-display geometry for the full and mobile surfaces. These are RenderSpec declarations, not review assertions.",
      "type": "object", "additionalProperties": false,
      "required": ["desktop", "mobile"],
      "properties": {
        "desktop": { "$ref": "#/$defs/desktop_publication_display_surface" },
        "mobile": { "$ref": "#/$defs/mobile_publication_display_surface" }
      }
    },
    "desktop_publication_display_surface": {
      "type": "object", "additionalProperties": false,
      "required": ["surface_id", "asset_scope", "article_body_width_css_px", "viewport_width_css_px"],
      "properties": {
        "surface_id": { "type": "string", "pattern": "^surface:[a-z0-9]+(-[a-z0-9]+)*$" },
        "asset_scope": { "const": "full" },
        "article_body_width_css_px": { "const": 672 },
        "viewport_width_css_px": { "type": "integer", "minimum": 672 }
      }
    },
    "mobile_publication_display_surface": {
      "type": "object", "additionalProperties": false,
      "required": ["surface_id", "asset_scope", "viewport_width_css_px", "article_body_width_css_px", "derivative_of_surface_id", "derivative_of_asset_scope", "crop_anchors"],
      "properties": {
        "surface_id": { "type": "string", "pattern": "^surface:[a-z0-9]+(-[a-z0-9]+)*$" },
        "asset_scope": { "const": "mobile" },
        "viewport_width_css_px": { "type": "integer", "minimum": 1 },
        "article_body_width_css_px": { "type": "integer", "minimum": 1 },
        "derivative_of_surface_id": { "type": "string", "pattern": "^surface:[a-z0-9]+(-[a-z0-9]+)*$" },
        "derivative_of_asset_scope": { "const": "full" },
        "crop_anchors": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^anchor:[a-z0-9]+(-[a-z0-9]+)*$" } }
      }
    },
    "claim_set": {
      "description": "Authoritative article claim identity. The article_ref claims_hash binds this declared set to the upstream article version.",
      "type": "object", "additionalProperties": false,
      "required": ["article_id", "claims_hash", "claim_ids"],
      "properties": {
        "article_id": { "type": "string", "pattern": "^art:[a-z0-9]+(-[a-z0-9]+)*$" },
        "claims_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "claim_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } }
      }
    }
  }
}
