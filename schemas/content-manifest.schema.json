{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suengj.com/schemas/content-manifest.schema.json",
  "title": "Content item manifest",
  "description": "Per-content inventory and preview contract. It carries references and publication-target drafts only; it grants no approval or publish authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_id", "revision", "producer_id", "source_refs", "artifacts", "targets", "title", "classification", "status"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "content_id": { "type": "string", "pattern": "^content:[a-z0-9]+(-[a-z0-9]+)*$" },
    "revision": { "type": "integer", "minimum": 1 },
    "producer_id": { "type": "string", "minLength": 1, "description": "Stable provenance identity retained across producer splits." },
    "source_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
    "targets": { "type": "array", "items": { "$ref": "#/$defs/target" } },
    "title": { "type": "string", "minLength": 1 },
    "classification": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "ready", "archived"] }
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "kind", "mime_type", "role", "locator", "locator_state", "sha256"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "mime_type": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" },
        "role": { "enum": ["clean_master", "publish_derivative", "supporting"] },
        "locator": { "type": "string", "minLength": 1 },
        "locator_state": { "enum": ["PENDING_SYNC", "CLOUD_READY"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "file_id": { "type": ["string", "null"] },
        "confirmed_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "text_value": { "type": "object", "additionalProperties": false, "properties": { "inline": { "type": "string" }, "artifact_ref": { "type": "string", "minLength": 1 } } },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["channel", "account_alias", "format", "media", "caption", "title", "description", "privacy"],
      "properties": {
        "channel": { "type": "string", "minLength": 1 }, "account_alias": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 }, "media": { "type": "array", "items": { "type": "string" } },
        "caption": { "$ref": "#/$defs/text_value" }, "title": { "$ref": "#/$defs/text_value" },
        "description": { "$ref": "#/$defs/text_value" }, "privacy": { "type": "string", "minLength": 1 }
      }
    }
  }
}
