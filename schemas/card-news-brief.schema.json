{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suengj.com/schemas/card-news-brief.schema.json",
  "title": "AES Card News Editorial Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reader_question", "angle", "facts", "so_what", "per_card"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "reader_question": { "type": "string", "minLength": 12 },
    "angle": { "type": "string", "minLength": 20, "maxLength": 240 },
    "facts": {
      "type": "array", "minItems": 6, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "value", "date", "source_url", "source_name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "value": { "type": "string", "minLength": 8 },
          "date": { "type": "string", "minLength": 4 },
          "source_url": { "type": "string", "format": "uri" },
          "source_name": { "type": "string", "minLength": 2 }
        }
      }
    },
    "so_what": { "type": "string", "minLength": 20 },
    "per_card": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["claim", "evidence", "evidence_fact_ids", "takeaway"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "evidence": { "type": "string", "minLength": 8 },
          "evidence_fact_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "takeaway": { "type": "string", "minLength": 8 }
        }
      }
    }
  }
}
