{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suengj.com/schemas/card-news-brief.schema.json",
  "title": "AES Card News Editorial Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reader_question", "angle", "facts", "so_what", "per_card"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "reader_question": { "type": "string", "minLength": 12 },
    "angle": { "type": "string", "minLength": 20, "maxLength": 240 },
    "facts": {
      "type": "array", "minItems": 6, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "value", "date", "source_url", "source_name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "value": { "type": "string", "minLength": 8 },
          "date": { "type": "string", "minLength": 4 },
          "source_url": { "type": "string", "format": "uri" },
          "source_name": { "type": "string", "minLength": 2 }
        }
      }
    },
    "so_what": { "type": "string", "minLength": 20 },
    "trend_eligibility": {
      "type": "object", "additionalProperties": false,
      "required": ["source_type", "observations", "direction"],
      "properties": {
        "source_type": { "enum": ["market_pmc", "official_statistics"] },
        "volume_24h": { "type": "number", "exclusiveMinimum": 0 },
        "updated_at": { "type": "string", "format": "date-time" },
        "checked_at": { "type": "string", "format": "date-time" },
        "source_name": { "type": "string", "minLength": 2 },
        "source_url": { "type": "string", "format": "uri" },
        "observation_period": { "type": "string", "minLength": 3 },
        "comparable": { "type": "boolean" },
        "observations": { "type": "array", "minItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["t", "p"], "properties": { "t": { "type": "string", "format": "date-time" }, "p": { "type": "number", "minimum": 0, "maximum": 100 } } } },
        "direction": { "enum": ["up", "down", "flat"] }
      }
    },
    "per_card": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["claim", "evidence", "evidence_fact_ids", "takeaway"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "evidence": { "type": "string", "minLength": 8 },
          "evidence_fact_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "visual_fact_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "visual_value_bindings": {
            "type": "array", "items": {
              "type": "object", "additionalProperties": false,
              "required": ["label", "value", "fact_id"],
              "properties": { "label": { "type": "string", "minLength": 1 }, "value": { "type": "number" }, "fact_id": { "type": "string" }, "display_value": { "type": "string", "minLength": 1 } }
            }
          },
          "takeaway": { "type": "string", "minLength": 8 }
        }
      }
    }
  }
}
