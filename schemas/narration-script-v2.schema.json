{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suengj.com/schemas/narration-script-v2.schema.json",
  "title": "Video Narration Script v2",
  "description": "Canonical source-grounded spoken text and its separate visual, pronunciation, and delivery metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "script_id", "video_plan_ref", "source_evidence_ref", "goal", "audience", "turns", "pronunciation_glossary", "protected_values", "delivery", "canonical_script_check", "caption_policy"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "script_id": { "type": "string", "pattern": "^narration-script:[a-z0-9]+(-[a-z0-9]+)*$" },
    "video_plan_ref": { "type": "string", "minLength": 1 },
    "source_evidence_ref": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "audience": { "enum": ["general-reader", "professional-generalist", "domain-practitioner", "domain-expert", "beginner-learner", "child-upper-elementary"] },
    "turns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/turn" } },
    "pronunciation_glossary": { "type": "array", "items": { "$ref": "#/$defs/pronunciation_entry" } },
    "protected_values": { "type": "array", "items": { "$ref": "#/$defs/protected_value" } },
    "delivery": { "$ref": "#/$defs/delivery" },
    "canonical_script_check": { "$ref": "#/$defs/canonical_script_check" },
    "caption_policy": { "$ref": "#/$defs/caption_policy" }
  },
  "$defs": {
    "turn": {
      "type": "object", "additionalProperties": false,
      "required": ["turn_id", "beat_id", "scene_id", "spoken_text", "on_screen_text", "source_refs", "evidence_span_ids"],
      "properties": {
        "turn_id": { "type": "string", "pattern": "^turn-[a-z0-9]+(-[a-z0-9]+)*$" },
        "beat_id": { "type": "string", "pattern": "^beat-[a-z0-9]+(-[a-z0-9]+)*$" },
        "scene_id": { "type": "string", "pattern": "^scene-[a-z0-9]+(-[a-z0-9]+)*$" },
        "spoken_text": { "type": "string", "minLength": 1 },
        "on_screen_text": { "type": "array", "items": { "$ref": "#/$defs/on_screen_text" } },
        "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence_span_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^evidence-[a-z0-9]+(-[a-z0-9]+)*$" } }
      }
    },
    "on_screen_text": {
      "type": "object", "additionalProperties": false,
      "required": ["exact_text", "source_ref", "protected", "evidence_span_ids"],
      "properties": {
        "exact_text": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "protected": { "type": "boolean" },
        "evidence_span_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^evidence-[a-z0-9]+(-[a-z0-9]+)*$" } }
      }
    },
    "pronunciation_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["term", "spoken_form", "source_ref"],
      "properties": {
        "term": { "type": "string", "minLength": 1 },
        "surface_text": { "type": "string", "minLength": 1 },
        "spoken_form": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 }
      }
    },
    "protected_value": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "exact_text", "source_ref", "locked"],
      "properties": {
        "kind": { "enum": ["number", "date", "unit", "name", "quote"] },
        "exact_text": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "locked": { "const": true }
      }
    },
    "delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["voice", "tone", "pace", "pause_after_ms", "emphasis"],
      "properties": {
        "voice": { "type": "string", "minLength": 1 },
        "tone": { "type": "string", "minLength": 1 },
        "pace": { "type": "string", "minLength": 1 },
        "pause_after_ms": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "emphasis": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "canonical_script_check": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "performed", "outcome", "evidence_ref"],
      "properties": {
        "phase": { "const": "pre_tts" },
        "performed": { "type": "boolean" },
        "outcome": { "enum": ["pass", "fail", "not_yet"] },
        "evidence_ref": { "type": ["string", "null"] }
      }
    },
    "caption_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["with_narration", "max_lines", "safe_zone"],
      "properties": {
        "with_narration": { "const": "on" },
        "max_lines": { "enum": [1, 2] },
        "safe_zone": { "enum": ["caption-safe", "all-safe"] }
      }
    }
  }
}
