  "field_domains": {"_note": "Value domain per overridable field (SUE-1426 fix B2). Values are normalised (NFC, trim, case-fold, whitespace/underscore -> hyphen) before comparison. enum_by_voice_family lists the only allowed values per voice family; \"_flow\" applies to non-SNS flows. Text fields are string-only and length-capped, and may not name another voice family's profile id or rule file. Object/array values are rejected when any key at any depth is a locked field.", "style_overlay": {"type": "enum_by_voice_family", "allowed": {"personal": ["suengj-style"], "business": ["none"], "community": ["none"], "_flow": ["none"]}}, "tone_intensity": {"type": "enum", "allowed": ["low", "medium", "high"]}, "preference_text": {"type": "text", "max_length": 500, "family_id_patterns": {"community": "(?<![a-z0-9])h\\d{2}(?![a-z0-9])"}}, "hook_pattern": {"type": "text", "max_length": 200, "family_id_patterns": {"community": "(?<![a-z0-9])h\\d{2}(?![a-z0-9])"}}, "call_to_action": {"type": "text", "max_length": 200}, "length_hint": {"type": "text", "max_length": 80}, "image_role": {"type": "text", "max_length": 80}, "text_policy": {"type": "text", "max_length": 80}, "canvas": {"type": "structure", "max_json_length": 200, "value_types": ["object"]}, "visual_recipe": {"type": "structure", "max_json_length": 4000, "value_types": ["object", "string"]}, "glossary_additions": {"type": "structure", "max_json_length": 4000, "value_types": ["object", "array"]}},
  "voice_profile_ids": {"_note": "Ids and file stems that identify each voice family; text fields of another family may not mention them.", "personal": ["suengj-style", "personal-instagram", "personal-linkedin"], "business": ["business-idea-magazine", "signalytics-benchmark-cards", "signalytics-news"], "community": ["trends-moa-community-tone", "trends-moa-community", "trends-moa"]},
